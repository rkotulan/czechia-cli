<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>czechia</ToolCommandName>
    <PackageId>Czechia.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>Neoficiální CLI pro správu DNS přes REST API CZECHIA.</Description>
    <Authors>rkotulan</Authors>
    <RepositoryUrl>https://github.com/rkotulan/czechia-cli</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rkotulan/czechia-cli</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dns;czechia;zoner;cli</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
